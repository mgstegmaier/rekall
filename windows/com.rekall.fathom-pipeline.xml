<?xml version="1.0" encoding="UTF-8"?>
<!-- Template, the Windows counterpart of launchd/com.rekall.fathom-pipeline.plist.
     install.sh fills __BASH__ (Git Bash's bash.exe), __REPO_WIN__ and __HOME_WIN__
     (this repo and your home folder, Windows paths with forward slashes) and registers
     it with Register-ScheduledTask. Runs hourly, 07:15 to 19:15. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Rekall: pull new Fathom meetings, write notes, ingest them into the wiki.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T07:15:00</StartBoundary>
      <Repetition>
        <Interval>PT1H</Interval>
        <Duration>PT12H</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
      <Enabled>true</Enabled>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <WakeToRun>false</WakeToRun>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__BASH__</Command>
      <Arguments>-c "'__REPO_WIN__/scripts/run-fathom-pipeline.sh' &gt;&gt; '__HOME_WIN__/.config/rekall/logs/fathom-pipeline.log' 2&gt;&amp;1"</Arguments>
    </Exec>
  </Actions>
</Task>
