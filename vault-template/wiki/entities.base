filters:
  and:
    - file.inFolder("wiki/pages")
    - note.type == "entity"
properties:
  file.name:
    displayName: Entity
  note.description:
    displayName: Description
  note.date:
    displayName: Last updated
  note.tags:
    displayName: Tags
views:
  - type: table
    name: All
    order:
      - file.name
      - description
      - date
      - tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Recently updated
    order:
      - file.name
      - description
      - date
    sort:
      - property: date
        direction: DESC
