filters:
  and:
    - file.inFolder("wiki/pages")
    - note.type == "project"
properties:
  file.name:
    displayName: Project
  note.description:
    displayName: Description
  note.date:
    displayName: Last updated
  note.tags:
    displayName: Tags
views:
  - type: table
    name: All
    order:
      - file.name
      - description
      - date
      - tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Recently updated
    order:
      - file.name
      - description
      - date
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Needs review
    filters:
      and:
        - file.hasTag("needs-review")
    order:
      - file.name
      - description
      - date
    sort:
      - property: date
        direction: DESC
