# Legacy secrets file, read last (after the environment and the OS keychain). New installs
# save keys on the settings page instead (SETUP.md step 4). Copy to .env (gitignored) only if
# you want the old file-based setup.

# --- Required for the turn-key install ---------------------------------------
# Fathom: Settings > Integrations > API in the Fathom web app.
FATHOM_API_KEY=
# The email address Fathom knows you by. Meetings without you as an attendee are skipped.
WORK_EMAIL=

# --- Optional: Monday action-item push (off in the turn-key version) ---------
# Leave blank and the pipeline runs as if --no-monday were passed.
# Board ID and group name live in rekall.toml under [monday].
MONDAY_API_TOKEN=

# --- Optional: Jira (not wired into the pipeline yet) -------------------------
JIRA_HOST=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# --- Optional: Microsoft Graph mail and Teams ingest (scripts/graph-ingest.py) ---
# Entra app with delegated READ scopes only (User.Read, Mail.Read, Chat.Read, Chat.ReadBasic,
# offline_access). scripts/setup-server.py signs you in and writes MSGRAPH_REFRESH_TOKEN here.
# Leave MSGRAPH_CLIENT_SECRET blank when the app allows public client flows (device-code sign-in).
# Off unless rekall.toml has [graph] enabled = true. SETUP.md has the steps.
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_REFRESH_TOKEN=
MSGRAPH_TENANT_ID=
