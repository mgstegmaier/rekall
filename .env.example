# Rekall secrets. Copy to .env (gitignored) and fill in what you use.
# Setup writes this file for you; the launchd jobs and the scripts load it.
# Loading by hand: set -a; source .env; set +a

# --- Required for the turn-key install ---------------------------------------
# Fathom: Settings > Integrations > API in the Fathom web app.
FATHOM_API_KEY=
# The email address Fathom knows you by. Meetings without you as an attendee are skipped.
WORK_EMAIL=

# --- Optional: Monday action-item push (off in the turn-key version) ---------
# Leave blank and the pipeline runs as if --no-monday were passed.
# Board ID and group name live in rekall.toml under [monday].
MONDAY_API_TOKEN=

# --- Optional: Jira (not wired into the pipeline yet) -------------------------
JIRA_HOST=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=
