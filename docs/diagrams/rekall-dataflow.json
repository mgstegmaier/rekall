  "cards": [
    {
      "dot": "emerald",
      "title": "Capture in",
      "items": [
        "Meeting notes and raw files are compiled into wiki pages by a headless sonnet run, one batch per pipeline pass",
        "State in ~/.config/rekall keeps every writer idempotent: meeting ids, file hashes, digest retry log"
      ]
    },
    {
      "dot": "cyan",
      "title": "Index and consume",
      "items": [
        "distil.py keeps an answer only when its quote appears in the note word for word; the rest is dropped and named",
        "rag.db is rebuilt hourly and can be deleted at any time; the recall hook fails open"
      ]
    },
    {
      "dot": "amber",
      "title": "Nightly health",
      "items": [
        "wiki-lint.py only reports; wiki-cleanup.py moves status: archive pages and unlinks hand-deleted ones",
        "wins-sweep.py appends session wins to the annual-review page each pipeline run"
      ]
    }
  ]
