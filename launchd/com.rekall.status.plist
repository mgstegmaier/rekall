<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Replace __REPO__ (this repo's absolute path) and __HOME__ (your home folder),
     then copy to ~/Library/LaunchAgents/ and `launchctl load` it. Runs Friday 15:00. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rekall.status</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/cos/run-status.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.config/rekall/logs/status.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.config/rekall/logs/status.log</string>
</dict>
</plist>
